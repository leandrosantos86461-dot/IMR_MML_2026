"""
AULA_04 - Exercicio 1
Validador de Pose em malha aberta (Cinematica Diferencial)

Calcula e simula a Pose (x, y, theta) de um robo diferencial
apos uma sequencia de comandos de velocidade (v, omega) temporizados.
"""

import math
import pygame

# ----------------------------------------------------------------------
# Parametros da simulacao
# ----------------------------------------------------------------------
DT = 0.02                    # passo de integracao (s)
ESCALA = 80                  # pixels por metro
LARGURA, ALTURA = 900, 600
ORIGEM = (150, ALTURA // 2)  # posicao do ponto (0,0) na tela, em pixels
FPS = 1 / DT

# Sequencia de comandos: (v [m/s], omega [rad/s], duracao [s])
COMANDOS = [
    (0.5, 0.0, 4.0),          # Trecho 1
    (0.0, math.pi / 4, 2.0),  # Trecho 2 (0.7854 rad/s)
    (0.4, 0.0, 3.0),          # Trecho 3
]


# ----------------------------------------------------------------------
# Modelo cinematico do robo diferencial (modelo unicycle)
# ----------------------------------------------------------------------
class RoboDiferencial:
    def __init__(self, x=0.0, y=0.0, theta=0.0):
        self.x = x
        self.y = y
        self.theta = theta
        self.trajeto = [(x, y)]

    def atualizar(self, v, omega, dt):
        """Integracao de Euler das equacoes do modelo unicycle."""
        self.x += v * math.cos(self.theta) * dt
        self.y += v * math.sin(self.theta) * dt
        self.theta += omega * dt
        self.trajeto.append((self.x, self.y))

    def pose(self):
        return self.x, self.y, self.theta


# ----------------------------------------------------------------------
# Pose teorica (solucao fechada)
# Em cada trecho apenas v OU omega e diferente de zero, entao a
# integracao exata coincide com a solucao analitica simples abaixo.
# ----------------------------------------------------------------------
def pose_teorica(comandos):
    x, y, theta = 0.0, 0.0, 0.0
    for v, omega, t in comandos:
        if abs(omega) < 1e-9:
            x += v * t * math.cos(theta)
            y += v * t * math.sin(theta)
        else:
            theta += omega * t
    return x, y, theta


# ----------------------------------------------------------------------
# Conversao de coordenadas do mundo (m) para tela (px)
# ----------------------------------------------------------------------
def mundo_para_tela(x, y):
    px = ORIGEM[0] + x * ESCALA
    py = ORIGEM[1] - y * ESCALA  # eixo Y da tela e invertido
    return int(px), int(py)


def desenhar_robo(tela, robo):
    cx, cy = mundo_para_tela(robo.x, robo.y)
    raio = 15
    pygame.draw.circle(tela, (30, 144, 255), (cx, cy), raio)
    fx = cx + raio * math.cos(robo.theta)
    fy = cy - raio * math.sin(robo.theta)
    pygame.draw.line(tela, (255, 255, 255), (cx, cy), (fx, fy), 3)


def desenhar_trajeto(tela, trajeto):
    if len(trajeto) < 2:
        return
    pontos = [mundo_para_tela(px, py) for px, py in trajeto]
    pygame.draw.lines(tela, (0, 200, 0), False, pontos, 2)


def print_resultados(robo):
    xt, yt, tt = pose_teorica(COMANDOS)
    xs, ys, ts = robo.pose()

    print("\n" + "=" * 60)
    print("RESULTADO - Exercicio 1: Validador de Pose (malha aberta)")
    print("=" * 60)
    print(f"Pose TEORICA  -> x = {xt:.4f} m | y = {yt:.4f} m | "
          f"theta = {math.degrees(tt):.2f} graus ({tt:.4f} rad)")
    print(f"Pose SIMULADA -> x = {xs:.4f} m | y = {ys:.4f} m | "
          f"theta = {math.degrees(ts):.2f} graus ({ts:.4f} rad)")
    print(f"Erro (teorico - simulado): "
          f"dx={xt - xs:.5f}  dy={yt - ys:.5f}  "
          f"dtheta={math.degrees(tt - ts):.5f} graus")
    print("=" * 60 + "\n")


# ----------------------------------------------------------------------
# Programa principal
# ----------------------------------------------------------------------
def main():
    pygame.init()
    tela = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("AULA_04 - Validador de Pose (malha aberta)")
    relogio = pygame.time.Clock()
    fonte = pygame.font.SysFont("consolas", 18)

    robo = RoboDiferencial(0.0, 0.0, 0.0)

    # Monta a fila de passos de integracao (v, omega) repetidos por DT
    fila_comandos = []
    for v, omega, duracao in COMANDOS:
        n_passos = int(round(duracao / DT))
        fila_comandos.extend([(v, omega)] * n_passos)

    idx = 0
    simulando = True
    executando = True

    while executando:
        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                executando = False

        if simulando and idx < len(fila_comandos):
            v, omega = fila_comandos[idx]
            robo.atualizar(v, omega, DT)
            idx += 1
        elif simulando:
            simulando = False
            print_resultados(robo)

        tela.fill((20, 20, 30))
        desenhar_trajeto(tela, robo.trajeto)
        desenhar_robo(tela, robo)

        x, y, th = robo.pose()
        info = f"x={x:.3f}  y={y:.3f}  theta={math.degrees(th):.2f} graus"
        texto = fonte.render(info, True, (255, 255, 255))
        tela.blit(texto, (10, 10))

        pygame.display.flip()
        relogio.tick(FPS)

    pygame.quit()


if __name__ == "__main__":
    main()
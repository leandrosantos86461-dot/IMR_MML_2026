"""
AULA_04 - Exercicio 2
Calculadora de giro Ackermann vs. Diferencial

Interface Pygame interativa onde o usuario controla v (velocidade linear)
e phi (angulo de esterco das rodas dianteiras) via teclado, e o script
calcula a velocidade angular e o raio de curvatura resultantes, alternando
entre o modelo Ackermann e o modelo Diferencial para efeito de comparacao.
"""

import math
import pygame

# ----------------------------------------------------------------------
# Parametros do veiculo / simulacao
# ----------------------------------------------------------------------
L = 2.0                       # entre-eixos (m)
PHI_MAX_DEG = 30.0             # limite do angulo de esterco (Ackermann)
COMANDO_MAX_DEG = 90.0         # limite do "comando angular" no modo Diferencial
V_MAX = 1.0                    # m/s
V_STEP = 0.05                  # m/s por tecla
PHI_STEP_DEG = 1.0             # graus por tecla
OMEGA_SCALE_DIFERENCIAL = 1.0  # ganho: mapeia o "comando" (rad) para omega (rad/s) no modo diferencial

ESCALA = 60                    # pixels por metro
LARGURA, ALTURA = 1000, 650
ORIGEM = (LARGURA // 2, ALTURA // 2)
DT = 0.02
FPS = 1 / DT

ACKERMANN = "ACKERMANN"
DIFERENCIAL = "DIFERENCIAL"

# Raio minimo teorico do Ackermann, calculado uma unica vez para referencia
R_MIN_ACKERMANN = L / math.tan(math.radians(PHI_MAX_DEG))


# ----------------------------------------------------------------------
# Calculo cinematico
# ----------------------------------------------------------------------
def calcular_omega_e_raio(modo, v, phi_rad):
    """Retorna (omega, raio) de acordo com o modelo escolhido.

    Ackermann: omega = (v / L) * tan(phi)          -> R = L / tan(phi)
    Diferencial: omega e comandado diretamente (independe de v)
                 -> permite R = 0 (giro sobre o proprio eixo, v = 0)
    """
    if modo == ACKERMANN:
        omega = (v / L) * math.tan(phi_rad)
    else:  # DIFERENCIAL
        omega = phi_rad * OMEGA_SCALE_DIFERENCIAL

    if abs(omega) < 1e-6:
        raio = math.inf
    else:
        raio = v / omega  # equivalente a L/tan(phi) no caso Ackermann

    return omega, raio


# ----------------------------------------------------------------------
# Conversao mundo -> tela
# ----------------------------------------------------------------------
def mundo_para_tela(x, y):
    px = ORIGEM[0] + x * ESCALA
    py = ORIGEM[1] - y * ESCALA
    return int(px), int(py)


def desenhar_veiculo(tela, x, y, theta, phi_rad, modo):
    cx, cy = mundo_para_tela(x, y)
    comprimento = L * ESCALA
    largura = 0.9 * ESCALA

    # Corpo do veiculo (retangulo orientado por theta)
    pontos_locais = [
        (comprimento / 2, largura / 2),
        (comprimento / 2, -largura / 2),
        (-comprimento / 2, -largura / 2),
        (-comprimento / 2, largura / 2),
    ]
    pontos_tela = []
    for lx, ly in pontos_locais:
        gx = cx + lx * math.cos(theta) - ly * math.sin(theta)
        gy = cy - (lx * math.sin(theta) + ly * math.cos(theta))
        pontos_tela.append((gx, gy))
    cor_corpo = (255, 140, 0) if modo == ACKERMANN else (30, 144, 255)
    pygame.draw.polygon(tela, cor_corpo, pontos_tela)
    pygame.draw.polygon(tela, (255, 255, 255), pontos_tela, 2)

    # Rodas dianteiras (so faz sentido visualmente no modo Ackermann)
    if modo == ACKERMANN:
        roda_comp = 0.35 * ESCALA
        for lado in (-1, 1):
            base_x = comprimento / 2
            base_y = lado * largura / 2
            ang_roda = theta + phi_rad
            fx1 = cx + base_x * math.cos(theta) - base_y * math.sin(theta)
            fy1 = cy - (base_x * math.sin(theta) + base_y * math.cos(theta))
            fx2 = fx1 + roda_comp * math.cos(ang_roda)
            fy2 = fy1 - roda_comp * math.sin(ang_roda)
            pygame.draw.line(tela, (0, 0, 0), (fx1, fy1), (fx2, fy2), 4)

    # Indicador de frente
    fx = cx + (comprimento / 2 + 10) * math.cos(theta)
    fy = cy - (comprimento / 2 + 10) * math.sin(theta)
    pygame.draw.circle(tela, (255, 255, 0), (int(fx), int(fy)), 4)


def desenhar_trajeto(tela, trajeto):
    if len(trajeto) < 2:
        return
    pontos = [mundo_para_tela(px, py) for px, py in trajeto]
    pygame.draw.lines(tela, (0, 200, 0), False, pontos, 2)


def texto_raio(raio):
    if math.isinf(raio):
        return "infinito (reto)"
    return f"{raio:.3f} m"


# ----------------------------------------------------------------------
# Programa principal
# ----------------------------------------------------------------------
def main():
    pygame.init()
    tela = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("AULA_04 - Ackermann vs Diferencial")
    relogio = pygame.time.Clock()
    fonte = pygame.font.SysFont("consolas", 18)
    fonte_pequena = pygame.font.SysFont("consolas", 15)

    x = y = theta = 0.0
    trajeto = [(0.0, 0.0)]

    v = 0.0
    phi_deg = 0.0
    modo = ACKERMANN

    ultimo_log = None
    executando = True

    print("=" * 60)
    print("Exercicio 2 - Ackermann vs Diferencial")
    print(f"L (entre-eixos) = {L} m | phi_max = +-{PHI_MAX_DEG} graus")
    print(f"Raio minimo teorico do Ackermann: R_min = L/tan(phi_max) = "
          f"{R_MIN_ACKERMANN:.3f} m (nunca chega a 0)")
    print("=" * 60)

    while executando:
        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                executando = False
            elif evento.type == pygame.KEYDOWN:
                if evento.key == pygame.K_TAB:
                    modo = DIFERENCIAL if modo == ACKERMANN else ACKERMANN
                elif evento.key == pygame.K_r:
                    x = y = theta = 0.0
                    trajeto = [(0.0, 0.0)]
                elif evento.key == pygame.K_ESCAPE:
                    executando = False

        teclas = pygame.key.get_pressed()
        if teclas[pygame.K_w]:
            v = min(V_MAX, v + V_STEP)
        if teclas[pygame.K_s]:
            v = max(-V_MAX, v - V_STEP)
        limite_deg = PHI_MAX_DEG if modo == ACKERMANN else COMANDO_MAX_DEG
        if teclas[pygame.K_a]:
            phi_deg = max(-limite_deg, phi_deg - PHI_STEP_DEG)
        if teclas[pygame.K_d]:
            phi_deg = min(limite_deg, phi_deg + PHI_STEP_DEG)

        phi_rad = math.radians(phi_deg)
        omega, raio = calcular_omega_e_raio(modo, v, phi_rad)

        # Integra a pose (Euler)
        x += v * math.cos(theta) * DT
        y += v * math.sin(theta) * DT
        theta += omega * DT
        trajeto.append((x, y))
        if len(trajeto) > 4000:
            trajeto.pop(0)

        # Log no terminal so quando v ou phi mudam de fato
        chave_log = (round(v, 3), round(phi_deg, 1), modo)
        if chave_log != ultimo_log:
            print(f"[{modo:11s}] v = {v:+.2f} m/s | phi = {phi_deg:+.1f} graus | "
                  f"omega = {omega:+.4f} rad/s | R = {texto_raio(raio)}")
            ultimo_log = chave_log

        # ---------------- desenho ----------------
        tela.fill((20, 20, 30))
        desenhar_trajeto(tela, trajeto)
        desenhar_veiculo(tela, x, y, theta, phi_rad, modo)

        linhas = [
            f"Modo (TAB alterna): {modo}",
            f"v = {v:+.2f} m/s   (W/S)",
            f"phi = {phi_deg:+.1f} graus   (A/D)   limite = +-{limite_deg:.0f} graus",
            f"omega = {omega:+.4f} rad/s",
            f"Raio de curvatura R = {texto_raio(raio)}",
            f"R minimo do Ackermann (phi_max) = {R_MIN_ACKERMANN:.3f} m",
            "R chega a 0 no Diferencial (v=0, omega!=0)"
            if modo == DIFERENCIAL else
            "Ackermann NUNCA zera R: mesmo com v baixo, R depende so de phi",
            "R = reinicia trajeto | ESC = sair",
        ]
        for i, linha in enumerate(linhas):
            fnt = fonte if i < 2 else fonte_pequena
            cor = (255, 255, 255) if i != 6 else (255, 210, 80)
            texto = fnt.render(linha, True, cor)
            tela.blit(texto, (10, 10 + i * 24))

        pygame.display.flip()
        relogio.tick(FPS)

    pygame.quit()


if __name__ == "__main__":
    main()
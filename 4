"""
AULA_04 - Exercicio 4
Braitenberg com conexoes diretas (Comportamento de Agressao/Atracao)

Sensor esquerdo -> roda esquerda, sensor direito -> roda direita (conexao
NAO cruzada / direta / ipsilateral). Ao detectar um obstaculo, o robo
acelera a roda do MESMO lado do sensor que o detectou, fazendo o robo
curvar em direcao ao obstaculo (comportamento de agressao/atracao),
oposto ao comportamento de aversao/medo (conexoes cruzadas) da Aula 03.
"""

import math
import pygame

# ----------------------------------------------------------------------
# Parametros do veiculo de Braitenberg
# ----------------------------------------------------------------------
V0 = 40.0             # velocidade base das rodas (px/s)
ALPHA = 140.0          # ganho de excitacao dos sensores (px/s)
D_MAX = 220.0          # alcance de deteccao dos sensores (px)
ANG_SENSOR = math.radians(35)  # divergencia angular dos sensores em relacao ao heading
L_EIXO = 34.0          # entre-eixos (px) - controla a sensibilidade do giro
RAIO_ROBO = 12.0

DIST_VARREDURA = D_MAX  # alcance fisico do raycast (igual ao alcance do sensor)

# ----------------------------------------------------------------------
# Tela / arena
# ----------------------------------------------------------------------
LARGURA, ALTURA = 1000, 650
ARENA = pygame.Rect(40, 40, 920, 570)
FPS = 60
DT = 1.0 / FPS

# Um unico obstaculo, conforme pedido no enunciado
OBSTACULO = (780, 380, 55)  # (cx, cy, raio)

POS_INICIAL = (120, 220)
THETA_INICIAL = 0.0  # olhando para +x (leste)


# ----------------------------------------------------------------------
# Ray casting simples ate a parede da arena ou o obstaculo
# ----------------------------------------------------------------------
def raycast(origem, angulo, dist_max, passo=2.0):
    ox, oy = origem
    dx, dy = math.cos(angulo), math.sin(angulo)
    cx, cy, raio = OBSTACULO
    t = 0.0
    while t < dist_max:
        px = ox + dx * t
        py = oy + dy * t
        if not ARENA.collidepoint(px, py):
            return t
        if (px - cx) ** 2 + (py - cy) ** 2 <= raio ** 2:
            return t
        t += passo
    return dist_max


def ler_sensores(pos, theta):
    ang_esq = theta - ANG_SENSOR
    ang_dir = theta + ANG_SENSOR
    d_esq = raycast(pos, ang_esq, DIST_VARREDURA)
    d_dir = raycast(pos, ang_dir, DIST_VARREDURA)
    return d_esq, d_dir, ang_esq, ang_dir


def calcular_velocidades(d_esq, d_dir):
    """Conexao DIRETA (ipsilateral): esq->esq, dir->dir."""
    d_esq_efetivo = min(d_esq, D_MAX)
    d_dir_efetivo = min(d_dir, D_MAX)
    vL = V0 + ALPHA * (1.0 - d_esq_efetivo / D_MAX)
    vR = V0 + ALPHA * (1.0 - d_dir_efetivo / D_MAX)
    return vL, vR


# ----------------------------------------------------------------------
# Desenho
# ----------------------------------------------------------------------
def desenhar_arena(tela):
    pygame.draw.rect(tela, (35, 35, 48), ARENA)
    pygame.draw.rect(tela, (90, 90, 110), ARENA, 2)
    cx, cy, raio = OBSTACULO
    pygame.draw.circle(tela, (170, 60, 60), (cx, cy), raio)


def desenhar_robo(tela, pos, theta, ang_esq, ang_dir, d_esq, d_dir):
    ox, oy = pos
    # feixes dos sensores
    ex = ox + min(d_esq, D_MAX) * math.cos(ang_esq)
    ey = oy + min(d_esq, D_MAX) * math.sin(ang_esq)
    dx = ox + min(d_dir, D_MAX) * math.cos(ang_dir)
    dy = oy + min(d_dir, D_MAX) * math.sin(ang_dir)
    pygame.draw.line(tela, (120, 180, 255), (ox, oy), (ex, ey), 1)
    pygame.draw.line(tela, (255, 150, 120), (ox, oy), (dx, dy), 1)

    pygame.draw.circle(tela, (30, 144, 255), (int(ox), int(oy)), int(RAIO_ROBO))
    fx = ox + (RAIO_ROBO + 14) * math.cos(theta)
    fy = oy + (RAIO_ROBO + 14) * math.sin(theta)
    pygame.draw.line(tela, (255, 255, 255), (ox, oy), (fx, fy), 3)


def desenhar_trajeto(tela, trajeto):
    if len(trajeto) < 2:
        return
    pygame.draw.lines(tela, (0, 200, 100), False, trajeto, 2)


# ----------------------------------------------------------------------
# Programa principal
# ----------------------------------------------------------------------
def main():
    pygame.init()
    tela = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("AULA_04 - Braitenberg (conexoes diretas / agressao)")
    relogio = pygame.time.Clock()
    fonte = pygame.font.SysFont("consolas", 16)
    fonte_pequena = pygame.font.SysFont("consolas", 14)

    x, y = POS_INICIAL
    theta = THETA_INICIAL
    trajeto = [(x, y)]
    colisoes = 0
    pausado = False
    executando = True

    print("=" * 60)
    print("Exercicio 4 - Braitenberg com conexoes diretas (agressao)")
    print(f"V0={V0} px/s | ALPHA={ALPHA} px/s | D_MAX={D_MAX} px | "
          f"ang_sensor=+-{math.degrees(ANG_SENSOR):.0f} graus")
    print("=" * 60)

    while executando:
        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                executando = False
            elif evento.type == pygame.KEYDOWN:
                if evento.key == pygame.K_ESCAPE:
                    executando = False
                elif evento.key == pygame.K_SPACE:
                    pausado = not pausado
                elif evento.key == pygame.K_r:
                    x, y = POS_INICIAL
                    theta = THETA_INICIAL
                    trajeto = [(x, y)]

        d_esq, d_dir, ang_esq, ang_dir = ler_sensores((x, y), theta)
        vL, vR = calcular_velocidades(d_esq, d_dir)

        if not pausado:
            v = (vL + vR) / 2.0
            omega = (vR - vL) / L_EIXO

            x += v * math.cos(theta) * DT
            y += v * math.sin(theta) * DT
            theta += omega * DT

            x = min(max(x, ARENA.left + RAIO_ROBO), ARENA.right - RAIO_ROBO)
            y = min(max(y, ARENA.top + RAIO_ROBO), ARENA.bottom - RAIO_ROBO)
            trajeto.append((x, y))
            if len(trajeto) > 3000:
                trajeto.pop(0)

            cx, cy, raio_obst = OBSTACULO
            dist_obst = math.hypot(x - cx, y - cy)
            if dist_obst <= raio_obst + RAIO_ROBO:
                colisoes += 1
                print(f"\n*** COLISAO #{colisoes}: o robo avancou sobre o obstaculo "
                      f"(comportamento de agressao/atracao confirmado) ***")
                print(f"Pose no impacto: x={x:.1f} y={y:.1f} theta={math.degrees(theta):.1f} graus")
                x, y = POS_INICIAL
                theta = THETA_INICIAL
                trajeto = [(x, y)]

        tela.fill((15, 15, 20))
        desenhar_arena(tela)
        desenhar_trajeto(tela, trajeto)
        desenhar_robo(tela, (x, y), theta, ang_esq, ang_dir, d_esq, d_dir)

        linhas = [
            f"d_esq = {d_esq:6.1f} px   ->   vL = {vL:6.1f} px/s",
            f"d_dir = {d_dir:6.1f} px   ->   vR = {vR:6.1f} px/s",
            f"omega = {(vR - vL) / L_EIXO:+.3f} rad/s   colisoes = {colisoes}",
            "SPACE = pausa | R = reinicia | ESC = sai",
        ]
        for i, linha in enumerate(linhas):
            fnt = fonte if i < 2 else fonte_pequena
            texto = fnt.render(linha, True, (255, 255, 255))
            tela.blit(texto, (10, 10 + i * 24))

        pygame.display.flip()
        relogio.tick(FPS)

    pygame.quit()


if __name__ == "__main__":
    main()
    
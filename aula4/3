"""
AULA_04 - Exercicio 3
Varredura Sensorial com Filtro de Alcance e Desvio de Ruido

Simula uma varredura de 7 feixes de distancia (FOV de 180 graus, de -pi/2
a +pi/2), adiciona ruido gaussiano as leituras reais (ray casting contra
obstaculos), e aplica um filtro de limiar antes de enviar o dado ao
"controlador". Renderiza lado a lado o valor bruto (ruidoso) e o valor
filtrado para cada feixe.
"""

import math
import numpy as np
import pygame

# ----------------------------------------------------------------------
# Parametros do sensor / filtro
# ----------------------------------------------------------------------
N_FEIXES = 7
FOV = math.pi          # 180 graus, de -pi/2 a +pi/2
RUIDO_DESVIO = 5.0      # desvio padrao do ruido gaussiano (px)
LIMIAR_MIN = 10.0       # abaixo disso -> leitura descartada (erro)
ALCANCE_MAX = 200.0     # acima disso -> cravado no alcance maximo
DIST_VARREDURA = 260.0  # alcance fisico da varredura (raycast), > ALCANCE_MAX
                        # de proposito, para demonstrar o "clamp"

# ----------------------------------------------------------------------
# Parametros de tela / arena
# ----------------------------------------------------------------------
LARGURA, ALTURA = 1100, 650
ARENA = pygame.Rect(40, 40, 780, 570)  # area livre de navegacao
PAINEL_X = 840                          # inicio do painel de texto lateral
FPS = 60

V_ROBO = 90.0     # px/s (W/S)
GIRO_ROBO = 2.2   # rad/s (A/D)

# Obstaculos (circulos) dentro da arena: (cx, cy, raio)
OBSTACULOS = [
    (250, 150, 45),
    (600, 420, 55),
    (700, 160, 35),
    (350, 480, 40),
]


# ----------------------------------------------------------------------
# Ray casting: distancia real ate a parede da arena ou um obstaculo
# ----------------------------------------------------------------------
def raycast(origem, angulo, dist_max, passo=2.0):
    ox, oy = origem
    dx, dy = math.cos(angulo), math.sin(angulo)
    t = 0.0
    while t < dist_max:
        px = ox + dx * t
        py = oy + dy * t

        # Colisao com a borda da arena
        if not ARENA.collidepoint(px, py):
            return t

        # Colisao com obstaculos circulares
        for cx, cy, raio in OBSTACULOS:
            if (px - cx) ** 2 + (py - cy) ** 2 <= raio ** 2:
                return t

        t += passo

    return dist_max


# ----------------------------------------------------------------------
# Filtro de limiar (threshold)
# ----------------------------------------------------------------------
def filtrar_leitura(d_ruido):
    """Retorna o valor filtrado, ou None se a leitura for descartada."""
    if d_ruido < LIMIAR_MIN:
        return None  # erro de leitura -> descartada
    if d_ruido > ALCANCE_MAX:
        return ALCANCE_MAX  # cravada no alcance maximo
    return d_ruido


def varrer(origem, theta_robo):
    """Executa a varredura completa dos N_FEIXES e retorna uma lista de
    dicts com: angulo_relativo, angulo_absoluto, real, bruto, filtrado."""
    angulos_rel = np.linspace(-FOV / 2, FOV / 2, N_FEIXES)
    leituras = []
    for ang_rel in angulos_rel:
        ang_abs = theta_robo + ang_rel
        d_real = raycast(origem, ang_abs, DIST_VARREDURA)
        d_ruido = d_real + np.random.normal(0, RUIDO_DESVIO)
        d_ruido = max(0.0, d_ruido)  # distancia nao pode ser negativa
        d_filtrado = filtrar_leitura(d_ruido)
        leituras.append({
            "ang_rel_deg": math.degrees(ang_rel),
            "ang_abs": ang_abs,
            "real": d_real,
            "bruto": d_ruido,
            "filtrado": d_filtrado,
        })
    return leituras


# ----------------------------------------------------------------------
# Desenho
# ----------------------------------------------------------------------
def desenhar_arena(tela):
    pygame.draw.rect(tela, (45, 45, 60), ARENA)
    pygame.draw.rect(tela, (90, 90, 110), ARENA, 2)
    for cx, cy, raio in OBSTACULOS:
        pygame.draw.circle(tela, (150, 60, 60), (cx, cy), raio)


def desenhar_robo(tela, origem, theta):
    ox, oy = origem
    pygame.draw.circle(tela, (30, 144, 255), (int(ox), int(oy)), 10)
    fx = ox + 18 * math.cos(theta)
    fy = oy + 18 * math.sin(theta)
    pygame.draw.line(tela, (255, 255, 255), (ox, oy), (fx, fy), 3)


def desenhar_feixes(tela, origem, leituras):
    ox, oy = origem
    for leitura in leituras:
        ang = leitura["ang_abs"]

        # Linha cinza tracejada = valor BRUTO (com ruido, sem filtro)
        bx = ox + leitura["bruto"] * math.cos(ang)
        by = oy + leitura["bruto"] * math.sin(ang)
        desenhar_linha_tracejada(tela, (ox, oy), (bx, by), (140, 140, 140))

        if leitura["filtrado"] is None:
            # Leitura descartada -> marcador vermelho perto do robo
            mx = ox + 22 * math.cos(ang)
            my = oy + 22 * math.sin(ang)
            pygame.draw.circle(tela, (220, 40, 40), (int(mx), int(my)), 5)
        else:
            fx = ox + leitura["filtrado"] * math.cos(ang)
            fy = oy + leitura["filtrado"] * math.sin(ang)
            pygame.draw.line(tela, (60, 220, 100), (ox, oy), (fx, fy), 2)
            pygame.draw.circle(tela, (60, 220, 100), (int(fx), int(fy)), 4)


def desenhar_linha_tracejada(tela, p1, p2, cor, comprimento_traco=6):
    x1, y1 = p1
    x2, y2 = p2
    dist = math.hypot(x2 - x1, y2 - y1)
    if dist < 1:
        return
    dx, dy = (x2 - x1) / dist, (y2 - y1) / dist
    t = 0.0
    desenhar = True
    while t < dist:
        seg = min(comprimento_traco, dist - t)
        if desenhar:
            xa, ya = x1 + dx * t, y1 + dy * t
            xb, yb = x1 + dx * (t + seg), y1 + dy * (t + seg)
            pygame.draw.line(tela, cor, (xa, ya), (xb, yb), 1)
        desenhar = not desenhar
        t += comprimento_traco


def desenhar_painel(tela, fonte, fonte_pequena, leituras):
    pygame.draw.rect(tela, (25, 25, 35), (PAINEL_X, 0, LARGURA - PAINEL_X, ALTURA))
    titulo = fonte.render("Feixe | Bruto -> Filtrado", True, (255, 255, 255))
    tela.blit(titulo, (PAINEL_X + 10, 15))

    y0 = 50
    for i, leitura in enumerate(leituras):
        ang = leitura["ang_rel_deg"]
        bruto = leitura["bruto"]
        filtrado = leitura["filtrado"]

        txt_filtrado = "DESCARTADO" if filtrado is None else f"{filtrado:6.1f} px"
        cor = (220, 40, 40) if filtrado is None else (60, 220, 100)

        linha1 = f"F{i} ({ang:+5.1f} graus)"
        linha2 = f"  bruto: {bruto:6.1f} px"
        linha3 = f"  filtrado: {txt_filtrado}"

        tela.blit(fonte_pequena.render(linha1, True, (255, 255, 255)),
                   (PAINEL_X + 10, y0))
        tela.blit(fonte_pequena.render(linha2, True, (180, 180, 180)),
                   (PAINEL_X + 10, y0 + 18))
        tela.blit(fonte_pequena.render(linha3, True, cor),
                   (PAINEL_X + 10, y0 + 36))
        y0 += 62

    legenda = [
        "Legenda:",
        "cinza tracejado = bruto (ruido)",
        "verde = filtrado (enviado ao ctrl)",
        "vermelho = descartado (< 10 px)",
        f"limiar min = {LIMIAR_MIN:.0f} px",
        f"alcance max = {ALCANCE_MAX:.0f} px",
    ]
    y0 += 10
    for linha in legenda:
        tela.blit(fonte_pequena.render(linha, True, (200, 200, 120)),
                   (PAINEL_X + 10, y0))
        y0 += 18


# ----------------------------------------------------------------------
# Programa principal
# ----------------------------------------------------------------------
def main():
    pygame.init()
    tela = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("AULA_04 - Varredura Sensorial com Filtro de Ruido")
    relogio = pygame.time.Clock()
    fonte = pygame.font.SysFont("consolas", 16)
    fonte_pequena = pygame.font.SysFont("consolas", 14)

    x, y = 150.0, 340.0
    theta = 0.0
    executando = True

    print("=" * 60)
    print("Exercicio 3 - Varredura Sensorial (7 feixes, FOV 180 graus)")
    print(f"Ruido gaussiano: media=0, desvio={RUIDO_DESVIO} px")
    print(f"Filtro: descarta < {LIMIAR_MIN} px | crava em {ALCANCE_MAX} px")
    print("Pressione ESPACO para imprimir uma varredura completa no terminal.")
    print("=" * 60)

    while executando:
        dt = relogio.tick(FPS) / 1000.0

        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                executando = False
            elif evento.type == pygame.KEYDOWN:
                if evento.key == pygame.K_ESCAPE:
                    executando = False

        teclas = pygame.key.get_pressed()
        if teclas[pygame.K_a]:
            theta -= GIRO_ROBO * dt
        if teclas[pygame.K_d]:
            theta += GIRO_ROBO * dt
        if teclas[pygame.K_w]:
            x += V_ROBO * math.cos(theta) * dt
            y += V_ROBO * math.sin(theta) * dt
        if teclas[pygame.K_s]:
            x -= V_ROBO * math.cos(theta) * dt
            y -= V_ROBO * math.sin(theta) * dt
        x = min(max(x, ARENA.left + 5), ARENA.right - 5)
        y = min(max(y, ARENA.top + 5), ARENA.bottom - 5)

        leituras = varrer((x, y), theta)

        if teclas[pygame.K_SPACE]:
            print("\n--- Varredura (SPACE) ---")
            for i, leitura in enumerate(leituras):
                txt_f = "DESCARTADO" if leitura["filtrado"] is None else f"{leitura['filtrado']:.2f} px"
                print(f"Feixe {i} ({leitura['ang_rel_deg']:+.1f} graus): "
                      f"real={leitura['real']:.2f} px | "
                      f"bruto(ruido)={leitura['bruto']:.2f} px | "
                      f"filtrado={txt_f}")

        tela.fill((15, 15, 20))
        desenhar_arena(tela)
        desenhar_feixes(tela, (x, y), leituras)
        desenhar_robo(tela, (x, y), theta)
        desenhar_painel(tela, fonte, fonte_pequena, leituras)

        instrucoes = "W/S move | A/D gira | SPACE imprime no terminal | ESC sai"
        tela.blit(fonte_pequena.render(instrucoes, True, (150, 150, 150)), (10, ALTURA - 22))

        pygame.display.flip()

    pygame.quit()


if __name__ == "__main__":
    main()
"""
AULA_04 - Exercicio 5
Centralizacao autonoma em corredor (Controle Proporcional)

O robo percorre um corredor retilinio com duas paredes paralelas. Dois
feixes laterais fixos a -90 e +90 graus (em relacao ao heading) medem a
distancia ate a parede esquerda (d_esq) e direita (d_dir). O erro de
centralizacao e = d_esq - d_dir alimenta uma lei de controle proporcional
omega = Kp * e, com velocidade linear v constante, corrigindo o robo de
volta ao centro mesmo quando ele comeca desalinhado.
"""

import math
import random
import pygame

# ----------------------------------------------------------------------
# Parametros de controle (conforme o enunciado)
# ----------------------------------------------------------------------
KP = 0.01     # ganho proporcional
V = 40.0      # velocidade linear constante (px/s)

# ----------------------------------------------------------------------
# Geometria do corredor / tela
# ----------------------------------------------------------------------
LARGURA, ALTURA = 1000, 600
FPS = 60
DT = 1.0 / FPS

LARGURA_CORREDOR = 300.0  # distancia entre as duas paredes (px)
CENTRO_Y = ALTURA / 2
Y_TOP = CENTRO_Y - LARGURA_CORREDOR / 2       # parede de cima
Y_BOTTOM = CENTRO_Y + LARGURA_CORREDOR / 2    # parede de baixo

X_INICIO = 40.0
X_FIM = LARGURA - 40.0
RAIO_ROBO = 10.0
OFFSET_MAX_INICIAL = 40.0  # desalinhamento inicial maximo sorteado a cada volta

DIST_MAX_SENSOR = 1000.0


# ----------------------------------------------------------------------
# Ray casting contra as paredes do corredor (linhas horizontais)
# ----------------------------------------------------------------------
def raycast(origem, angulo, dist_max=DIST_MAX_SENSOR, passo=1.0):
    ox, oy = origem
    dy = math.sin(angulo)
    if abs(dy) < 1e-9:
        return dist_max  # feixe paralelo as paredes, nunca as atinge
    t = 0.0
    while t < dist_max:
        py = oy + dy * t
        if py <= Y_TOP or py >= Y_BOTTOM:
            return t
        t += passo
    return dist_max


def ler_sensores(pos, theta):
    """Feixes laterais fixos a +90 e -90 graus em relacao ao heading."""
    ang_esq = theta + math.pi / 2
    ang_dir = theta - math.pi / 2
    d_esq = raycast(pos, ang_esq)
    d_dir = raycast(pos, ang_dir)
    return d_esq, d_dir, ang_esq, ang_dir


# ----------------------------------------------------------------------
# Desenho
# ----------------------------------------------------------------------
def desenhar_corredor(tela):
    pygame.draw.rect(tela, (60, 60, 75), (0, 0, LARGURA, Y_TOP))
    pygame.draw.rect(tela, (60, 60, 75), (0, Y_BOTTOM, LARGURA, ALTURA - Y_BOTTOM))
    pygame.draw.line(tela, (255, 255, 255), (0, CENTRO_Y), (LARGURA, CENTRO_Y), 1)
    pygame.draw.line(tela, (0, 200, 255), (X_FIM, Y_TOP), (X_FIM, Y_BOTTOM), 2)


def desenhar_robo(tela, pos, theta, ang_esq, ang_dir, d_esq, d_dir):
    ox, oy = pos
    ex = ox + min(d_esq, 400) * math.cos(ang_esq)
    ey = oy + min(d_esq, 400) * math.sin(ang_esq)
    dx = ox + min(d_dir, 400) * math.cos(ang_dir)
    dy = oy + min(d_dir, 400) * math.sin(ang_dir)
    pygame.draw.line(tela, (120, 180, 255), (ox, oy), (ex, ey), 1)
    pygame.draw.line(tela, (255, 150, 120), (ox, oy), (dx, dy), 1)

    pygame.draw.circle(tela, (30, 144, 255), (int(ox), int(oy)), int(RAIO_ROBO))
    fx = ox + (RAIO_ROBO + 12) * math.cos(theta)
    fy = oy + (RAIO_ROBO + 12) * math.sin(theta)
    pygame.draw.line(tela, (255, 255, 255), (ox, oy), (fx, fy), 3)


def desenhar_trajeto(tela, trajeto):
    if len(trajeto) < 2:
        return
    pygame.draw.lines(tela, (0, 220, 120), False, trajeto, 2)


def novo_inicio():
    offset = random.uniform(-OFFSET_MAX_INICIAL, OFFSET_MAX_INICIAL)
    return X_INICIO, CENTRO_Y + offset, 0.0


# ----------------------------------------------------------------------
# Programa principal
# ----------------------------------------------------------------------
def main():
    pygame.init()
    tela = pygame.display.set_mode((LARGURA, ALTURA))
    pygame.display.set_caption("AULA_04 - Centralizacao em corredor (P-control)")
    relogio = pygame.time.Clock()
    fonte = pygame.font.SysFont("consolas", 16)
    fonte_pequena = pygame.font.SysFont("consolas", 14)

    x, y, theta = novo_inicio()
    trajeto = [(x, y)]
    voltas = 0
    colisoes = 0
    pausado = False
    executando = True

    print("=" * 60)
    print("Exercicio 5 - Centralizacao autonoma em corredor")
    print(f"Kp={KP} | v={V} px/s | largura do corredor={LARGURA_CORREDOR} px")
    print(f"Pose inicial: x={x:.1f} y={y:.1f} (offset do centro = {y-CENTRO_Y:+.1f} px)")
    print("=" * 60)

    while executando:
        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                executando = False
            elif evento.type == pygame.KEYDOWN:
                if evento.key == pygame.K_ESCAPE:
                    executando = False
                elif evento.key == pygame.K_SPACE:
                    pausado = not pausado

        d_esq, d_dir, ang_esq, ang_dir = ler_sensores((x, y), theta)
        e = d_esq - d_dir
        omega = KP * e

        if not pausado:
            x += V * math.cos(theta) * DT
            y += V * math.sin(theta) * DT
            theta += omega * DT
            trajeto.append((x, y))
            if len(trajeto) > 4000:
                trajeto.pop(0)

            if y <= Y_TOP + RAIO_ROBO or y >= Y_BOTTOM - RAIO_ROBO:
                colisoes += 1
                print(f"\n*** BATEU NA PAREDE #{colisoes}: y={y:.1f} "
                      f"(offset={y-CENTRO_Y:+.1f} px) em x={x:.1f} ***")
                x, y, theta = novo_inicio()
                trajeto = [(x, y)]

            elif x >= X_FIM:
                voltas += 1
                print(f"\n--- Chegou ao fim do corredor (volta {voltas}) sem bater. "
                      f"Offset final = {y-CENTRO_Y:+.1f} px ---")
                x, y, theta = novo_inicio()
                trajeto = [(x, y)]

        tela.fill((15, 15, 20))
        desenhar_corredor(tela)
        desenhar_trajeto(tela, trajeto)
        desenhar_robo(tela, (x, y), theta, ang_esq, ang_dir, d_esq, d_dir)

        linhas = [
            f"d_esq = {d_esq:6.1f} px   d_dir = {d_dir:6.1f} px",
            f"e = d_esq - d_dir = {e:+7.2f}   omega = Kp*e = {omega:+.4f} rad/s",
            f"offset do centro = {y-CENTRO_Y:+6.1f} px   voltas={voltas}  colisoes={colisoes}",
            "SPACE = pausa | ESC = sai",
        ]
        for i, linha in enumerate(linhas):
            fnt = fonte if i < 2 else fonte_pequena
            texto = fnt.render(linha, True, (255, 255, 255))
            tela.blit(texto, (10, 10 + i * 22))

        pygame.display.flip()
        relogio.tick(FPS)

    pygame.quit()


if __name__ == "__main__":
    main()
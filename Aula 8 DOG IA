def run_benchmark(n,seed):
    rng=random.Random(seed);results=[]
    for trial in range(n):
        world=World(rng.randint(0,2**31-1));robot=Robot(world);robot.choose('1',world)
        dt=1/30
        for _ in range(30*100):
            world.step(dt);robot.step(dt,world)
            if robot.state=='CHEGOU':break
        results.append((robot.completed>0,robot.travel_times[-1] if robot.travel_times else None,robot.collisions,robot.near))
    wins=sum(r[0] for r in results)
    times=[r[1] for r in results if r[1] is not None]
    print('DOG-IA V2 | benchmark',n,'| seed',seed)
    print('Taxa de sucesso: %.1f%%'%(100*wins/n))
    print('Tempo médio (viagens concluídas):',round(statistics.mean(times),2) if times else 'N/D','s')
    print('Colisões:',sum(r[2] for r in results))
    print('Quase-colisões (contagem por quadro):',sum(r[3] for r in results))
    print('Viagens concluídas:',wins,'/',n)

def main():
    parser=argparse.ArgumentParser();parser.add_argument('--benchmark',type=int,default=0);parser.add_argument('--seed',type=int,default=1)
    args=parser.parse_args()
    if args.benchmark:
        run_benchmark(args.benchmark,args.seed);return
    pygame.init();screen=pygame.display.set_mode((W,H));pygame.display.set_caption('DOG-IA V2 — Cão-guia robô (F11: tela cheia)')
    fonts=(pygame.font.SysFont('arial',19,bold=True),pygame.font.SysFont('arial',16),pygame.font.SysFont('arial',21,bold=True))
    world=World(args.seed);robot=Robot(world);clock=pygame.time.Clock();paused=False;lidar=True;running=True
    while running:
        dt=min(clock.tick(FPS)/1000,.05)
        for event in pygame.event.get():
            if event.type==pygame.QUIT:running=False

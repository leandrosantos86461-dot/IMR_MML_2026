                    pos=event.pos;robot.target=('Ponto livre',pos);robot.route=grid_path((robot.x,robot.y),pos);robot.idx=0;robot.state='NAVEGANDO';robot.start_time=world.time
                elif event.button==3:OBST.append((pygame.Rect(event.pos[0]-18,event.pos[1]-18,36,36),'solo'))
